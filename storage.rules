rules_version = '2';

// =========================================================
// قواعد أمان Firebase Storage لموقع "دكان"
// =========================================================
// ملحوظة مهمة: الموقع دلوقتي بيخزّن صور المنتجات كـ base64 جوه
// Firestore مباشرة، فمش محتاج Firebase Storage خالص، ومش محتاج
// تفعّل خطة Blaze عشان الموقع يشتغل ويتنشر بالمجان بالكامل.
// الملف ده سايبينه لو حبيت مستقبلاً تفعّل Storage فعلياً
// (مثلاً لصور بجودة أعلى)، وقتها انسخ القواعد دي زي ما هي.
// =========================================================
service firebase.storage {
  match /b/{bucket}/o {

    // صور المنتجات: أي حد يقدر يشوفها، بس الرفع لازم يكون من صاحب المجلد نفسه
    // (كل مستخدم بيرفع صوره في مجلد products/{uid}/...)
    // وبحد أقصى 5 ميجا لكل صورة، ونوع الملف لازم يكون صورة فعلاً
    match /products/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
