rules_version = '2';

// =========================================================
// قواعد أمان Firestore لموقع "دكان"
// انسخ المحتوى ده في Firebase Console > Firestore Database > Rules
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- مجموعة المنتجات ----
    // أي حد (حتى لو مش مسجل دخول) يقدر يقرأ المنتجات عشان يتصفح ويبحث
    // بس النشر والتعديل والحذف يتطلب تسجيل دخول، والتعديل/الحذف لازم يكون من صاحب المنتج نفسه
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    // الصور بقت متخزنة كـ base64 جوه المستند نفسه (بدل Firebase Storage)،
                    // فبنتأكد إن عددها معقول (لغاية 4) وحجم المستند كله ماتعديش حد Firestore (1 ميجا)
                    && request.resource.data.images is list
                    && request.resource.data.images.size() > 0
                    && request.resource.data.images.size() <= 4
                    && request.resource.data.size() < 1000000;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // ---- مجموعة المستخدمين ----
    // كل مستخدم يقدر يقرأ ويعدّل بيانات حسابه هو بس
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
